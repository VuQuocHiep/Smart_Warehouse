# Copy to .env and replace these values before starting Compose.
# Use single quotes if a value contains a dollar sign.
DB_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password
DEMAND_SERVICE_TOKEN=replace-with-private-ml-token
IOT_INGEST_KEY=replace-with-device-key
HTTP_PORT=8088
# Must match deviceCode in the ESP32 firmware.
IOT_SCALE_DEVICE_CODE=ESP_ENV_01
MQ2_GAS_LEVEL1=1800
MQ2_GAS_LEVEL2=2500
MQ2_GAS_LEVEL3=3200
# Optional HTTPS override: directory containing fullchain.pem and privkey.pem.
HTTPS_PORT=8443
TLS_CERT_DIR=./certs

# Optional local settings. Without JWT_SECRET, local sessions expire on backend restart.
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=ADMINPTIT@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
# Cloud setup and all Render/GitHub secrets: see docs/cloud-render.md.
